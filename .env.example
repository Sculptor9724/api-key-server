# Required for Gemini-powered endpoints
GEMINI_API_KEY=

# Required for GitHub repository access
GITHUB_API_KEY=

# Required for Supabase-backed account deletion
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Required for database-backed endpoints
DATABASE_URL=

# Required for the budget webhook; generate a random value for your deployment
BUDGET_WEBHOOK_SECRET=

# Optional server configuration
PORT=3002
NODE_ENV=development
JSON_BODY_LIMIT=10mb
FORM_BODY_LIMIT=10mb

# Local development only; never enable in production
DISABLE_AUTH=false
